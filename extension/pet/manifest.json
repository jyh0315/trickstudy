{
  "manifest_version": 3,
  "name": "트릭스터디 펫",
  "version": "1.0.0",
  "description": "트릭스터디 대표 사도가 크롬 화면 아래를 돌아다녀요.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "트릭스터디 펫" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://jyh0315.github.io/*", "https://lootandwaifus.com/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://jyh0315.github.io/trickstudy/*"], "js": ["sync.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["pet.html"], "matches": ["<all_urls>"] }]
}
